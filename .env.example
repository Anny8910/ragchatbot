# Copy to .env to override any default. NOT required: the default build runs with
# no .env at all (architecture D3). Every key below has a working default in
# rag_bot/config.py DEFAULTS, so an empty .env is valid.
#
# No API key is needed for the default build. RAG_PROVIDER=ollama talks to a
# local Ollama daemon. Only change RAG_PROVIDER if you point at a hosted LLM,
# in which case that provider's own key variable belongs here too.

# --- LLM provider ---
# Local Ollama daemon (default). Must be running: `ollama serve`.
RAG_PROVIDER=ollama
RAG_LLM_MODEL=llama3.5:8b
RAG_OLLAMA_HOST=http://localhost:11434

# --- embeddings ---
# Fixed by the PRD; changing it changes the Chroma collection name (architecture D5).
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- generation ---
# Low temperature: the assistant states retrieved facts, it does not improvise.
RAG_TEMPERATURE=0.1
RAG_MAX_SENTENCES=3

# --- retrieval ---
# Overfetch k+2 in rag_bot/index/store.py. Must stay <= COLLECTION contents.
RAG_TOP_K=3
# Cosine-similarity floor for the class-B gate. P3 must verify empirically that
# Chroma's distance is 1 - cosine before trusting this number.
RAG_MIN_SCORE=0.35

# --- chunking ---
# Must be <= 224 (validate() enforces headroom under the 256 word-piece cap).
RAG_CHUNK_TOKENS=180
RAG_CHUNK_OVERLAP=40

# --- paths ---
RAG_CORPUS_DIR=data/corpus
RAG_INDEX_DIR=data/index
RAG_SOURCES_FILE=rag_bot/sources/sources.yaml

# --- behaviour toggles ---
# false disables the LLM triage layer, leaving the deterministic rule layer only.
RAG_TRIAGE_LLM=true
# false disables the input-boundary PII scrub (P5).
RAG_PII_REDACT=true
# true enables the corpus guard: the builder hard-fails if any
# FORBIDDEN_FIELDS / FORBIDDEN_PATTERNS content reaches a chunk. Under the P0
# renumbering this no longer drives a regex scrubber (old P2 was dissolved); it
# now gates the allowlist guard defined in P2 and enforced in P3.
RAG_SANITIZE_PERF=true

# --- UI ---
# 0 disables conversational memory, so each question is answered independently.
RAG_HISTORY_TURNS=0
RAG_LOG_TRACE=true

# --- hosted providers (not set by default) ---
# Only needed when RAG_PROVIDER=groq, which is what the deployed service uses.
# Read by rag_bot/providers/groq.py at construction, and a missing key raises a
# named error there rather than surfacing later as a 401 mid-request.
# NEVER commit a real value. On Render, set it in the dashboard instead:
# Service -> Environment -> Add.
#
# GROQ_API_KEY=
#
# GROQ_MODEL overrides RAG_LLM_MODEL for the Groq provider specifically, so the
# model can be repointed without touching the RAG_* settings.
# GROQ_MODEL=openai/gpt-oss-120b
#
# The Groq free tier enforces 200k tokens per DAY, and a full 52-row eval costs
# roughly that much. See docs/chunking-decision.md section 8.
